{
  "name": "@tinysecrets/propulse",
  "version": "1.0.0",
  "description": "Make any app proactive. ProPulse AI client for Node and the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "proactive",
    "notifications",
    "agents",
    "propulse",
    "background"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tinysecrets/propulse"
  }
}
