            "type": "string"
          },
          "delivered_at": {
            "default": 0.0,
            "title": "Delivered At",
            "type": "number"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "title": "AckBody",
        "type": "object"
      },
      "DeviceRegisterBody": {
        "properties": {
          "app_version": {
            "default": "",
            "title": "App Version",
            "type": "string"
          },
          "attestation": {
            "default": "",
            "title": "Attestation",
            "type": "string"
          },
          "install_id": {
            "title": "Install Id",
            "type": "string"
          },
          "locale": {
            "default": "en",
            "title": "Locale",
            "type": "string"
          },
          "platform": {
            "enum": [
              "android",
              "ios",
              "web",
              "server"
            ],
            "title": "Platform",
            "type": "string"
          },
          "push_token": {
            "default": "",
            "title": "Push Token",
            "type": "string"
          },
          "sdk_version": {
            "default": "",
            "title": "Sdk Version",
            "type": "string"
          },
          "timezone": {
            "default": "UTC",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "install_id",
          "platform"
        ],
        "title": "DeviceRegisterBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SignalBody": {
        "properties": {
          "client_ts": {
            "default": 0.0,
            "title": "Client Ts",
            "type": "number"
          },
          "device_state": {
            "additionalProperties": true,
            "title": "Device State",
            "type": "object"
          },
          "install_id": {
            "title": "Install Id",
            "type": "string"
          },
          "pulse": {
            "title": "Pulse",
            "type": "string"
          },
          "trigger": {
            "additionalProperties": true,
            "title": "Trigger",
            "type": "object"
          }
        },
        "required": [
          "pulse",
          "install_id"
        ],
        "title": "SignalBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "email": "eng@wah-lah.com",
      "name": "Wah-Lah"
    },
    "description": "\n**Make any app proactive.** ProPulse is a background event-driven agent orchestrator.\n\n* `pp_pub_*` keys are embedded in app binaries and require HMAC request signing.\n* `pp_secret_*` keys are server-side and may call privileged routes.\n* Hitting a quota returns `429` with an `upgrade_url` \u2014 that is the whole billing funnel.\n\nServer is **AGPL-3.0-or-later**. `GET /source` satisfies section 13.\n",
    "license": {
      "name": "AGPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/agpl-3.0.html"
    },
    "title": "Wah-Lah ProPulse AI",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
