SECRET_KEY=dev-only-change-me-in-production-32bytes
ENV=local
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8080
UPGRADE_URL=https://propulse.wah-lah.com/upgrade
COMMERCIAL_LICENSE_URL=https://propulse.wah-lah.com/license

MONGO_URI=mongodb://mongo:27017/propulse
MONGO_DB=propulse
SOURCE_REPO_URL=https://github.com/tinysecrets/propulse
LICENSE_SIGNING_SECRET=
MONGO_MAX_POOL_SIZE=20
REDIS_URL=redis://redis:6379/0
BUS_DRIVER=redis
STORAGE_DRIVER=fs
STORAGE_PATH=/var/lib/propulse/media

BILLING_DRIVER=null
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_COMMERCIAL_SINGLE=
STRIPE_PRICE_COMMERCIAL_UNLIMITED=

LLM_DRIVER=echo
LLM_BASE_URL=http://ollama:11434
LLM_MAX_TOKENS_PER_TENANT_PER_DAY=200000

TTS_DRIVER=piper
PIPER_MODEL_PATH=/opt/piper/en_US-amy-medium.onnx

RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=600
RATE_LIMIT_TEAM=3000
RATE_LIMIT_FAIL_OPEN=true

FREE_MONTHLY_PULSES=1000
PRO_MONTHLY_PULSES=50000
TEAM_MONTHLY_PULSES=500000

OTEL_ENABLED=false
TELEMETRY_ENABLED=true
FLAG_COMPOUND_TRIGGERS=true
FLAG_PREDICTIVE_SEND_TIME=false
GLOBAL_KILL=false
